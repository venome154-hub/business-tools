# Canonical origin used in metadata, sitemaps, and embed snippets.
# Optional. Defaults to https://www.biztoolsbox.online
NEXT_PUBLIC_SITE_URL=https://www.biztoolsbox.online

# Search Console HTML-tag verification. Leave unset to omit the meta tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Public IndexNow key. Must match the file public/<key>.txt and the GitHub secret INDEXNOW_KEY.
INDEXNOW_KEY=5f63fbe80e01b2bf54a2dc4aff6a7b4d
